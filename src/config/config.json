{
  "site": {
    "title": "Go UMKM",
    "base_url": "https://example.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/Go (2).png",
    "logo_darkmode": "/images/Go (2).png",
    "logo_width": "150",
    "logo_height": "39",
    "logo_text": "Geeky"
  },

  "settings": {
    "search": true,
    "sticky_header": false,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 6,
    "InnerPaginationOptions": {
      "enableTop": false,
      "enableBottom": true
    },
    "summary_length": 200,
    "post_folder": "posts"
  },

  "params": {
    "contact_form_action": "#",
    "footer_content": "Berbagi ide dan kepedulian untuk tumbuh-kembang UMKM di Indonesia, melalui transformasi digital.",
    "copyright": "Designed and Developed By [Statichunt](https://statichunt.com/)"
  },

  "widgets": {
    "about": {
      "enable": true,
      "content": "Berbagi ide dan kepedulian untuk tumbuh-kembang UMKM di Indonesia, melalui transformasi digital."
    },
    "featured_posts": {
      "enable": true,
      "title": "Kategori",
      "showPost": 3
    },
    "categories": {
      "enable": true,
      "title": "Kategori"
    },
    "newsletter": {
      "enable": true,
      "title": "Newsletter",
      "content": "Bergabung bersama kami, dan dapatkan artikel-artikel informatif terkait digitalisasi UMKM ",
      "privacy_policy_page": "/privacy-policy",
      "malichipm_url": "peluangusahaku68@gmail.com"
    }
  },
  "navigation_button": {
    "enable": true,
    "label": "Get Started",
    "link": "https://example.com"
  },

  "metadata": {
    "meta_author": "statichunt",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind boilerplate"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  }
}
